{
  "name": "taptreepay/taptree-woocommerce",
  "description": "TapTree Payments for WooCommerce",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "minimum-stability": "dev",
  "authors": [
    {
      "name": "TapTree GmbH",
      "email": "info@taptree.org"
    }
  ],
  "require": {
    "php": ">=7.4",
    "psr/log": "^3.0.0",
    "monolog/monolog": "^3.0",
    "inpsyde/modularity": "^1.3.0",
    "psr/container": "2.0.2"
  },
  "require-dev": {
    "wp-cli/wp-cli-bundle": "2.12.0"
  },
  "autoload": {
    "psr-4": {
      "TapTree\\WooCommerce\\": "src/",
      "Inpsyde\\EnvironmentChecker\\": "pluginEnvironmentChecker"
    }
